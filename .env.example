# Database (SQLite)
DATABASE_URL="file:./dev.db"

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# JWT (env.ts uses JWT_SECRET / JWT_EXPIRES_IN, or falls back to JWT_ACCESS_*)
JWT_SECRET=your-secret-change-in-production
JWT_EXPIRES_IN=15m

# OpenAI (for AI coach)
OPENAI_API_KEY=sk-your-openai-api-key

# chain — simulation is fine for local; live needs hardhat node + deploy
BLOCKCHAIN_MODE=simulation
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
# BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# LOAN_CONTRACT_ADDRESS=
# ATTESTATION_CONTRACT_ADDRESS=
